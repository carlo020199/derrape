{
  "name": "@derrape/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:colyseus --external:@colyseus/* --external:express --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@colyseus/ws-transport": "^0.16.0",
    "@derrape/shared": "*",
    "colyseus": "^0.16.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "colyseus.js": "^0.16.22",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0"
  }
}
